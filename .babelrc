{
  "presets": [
    [
      "env",
      {
        "loose": true,
        "modules": false,
        "targets": {
          "browsers": ["> 1%", "last 2 versions", "not ie <= 8"]
        }
      }
    ],
    "stage-2"
  ],
  "plugins": ["transform-vue-jsx"],
  "env": {
    "utils": {
      "presets": [
        ["env", "stage-2"],
      ],
      "plugins": [
        ["module-resolver", {
          "root": ["rumo-ui"],
          "alias": {
            "rumo-ui/src": "rumo-ui/lib"
          }
        }]
      ]
    }
  }
}
